module LBManager {
  extern module CkMarshall;
  extern module BaseLB;

  readonly CkGroupID _lbmgr;

  mainchare LBMgrInit {
    entry LBMgrInit(CkArgMsg *m);
  };

  group [migratable] LBManager {
    entry void LBManager(void);
    entry void ResumeClients();
    // CkLBSetAsync, on every PE.
    entry void setAsyncMode(bool on);
    // The destination's ack of the move ledger: the migrated element has
    // registered, so its entry on the source can be retired.
    entry void ledgerRetire(int locMgr, CmiUInt8 id, int step);
    entry void collectObjLoads();
    entry void objLoadsCollected(CkReductionMsg* m);
    initnode void initnodeFn();
  };

};

