module LBManager {
  extern module CkMarshall;
  extern module BaseLB;

  readonly CkGroupID _lbmgr;

  mainchare LBMgrInit {
    entry LBMgrInit(CkArgMsg *m);
  };

  group [migratable] LBManager {
    entry void LBManager(void);
    entry void StartLB();
    entry void ResumeClients();
    // Destination-side ack of the move ledger: the migrated element has
    // registered, so its entry on the source can be retired.
    entry void ledgerRetire(CmiUInt8 id, int step);
    initnode void initnodeFn();
  };

};

