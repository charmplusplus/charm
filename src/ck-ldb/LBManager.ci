module LBManager {
  extern module CkMarshall;
  extern module BaseLB;

  readonly CkGroupID _lbmgr;

  mainchare LBMgrInit {
    entry LBMgrInit(CkArgMsg *m);
  };

  group [migratable] LBManager {
    entry void LBManager(void);
    entry void StartLB();
    entry void ResumeClients();
    entry void ResumeClientsIfHeld();
    entry void RescaleTentative(int tentative, int gen);
    entry [reductiontarget] void RescaleFinal(int n, int v[n]);
    entry void RescaleCommit(int final, int gen);
    entry void RescaleAnnounceDoom(std::vector<char> bitmap);
    initnode void initnodeFn();
  };

};

