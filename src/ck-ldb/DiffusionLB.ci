module DiffusionLB
{
  readonly int numPes;

  include "CentralLBMsg.h";
  extern module DistBaseLB;
  extern module CkMulticast;
  initnode void lbinit(void);

  message PseudoRoundMsg;

  group[migratable] DiffusionLB : DistBaseLB
  {
    entry void DiffusionLB(const CkLBOptions&);
    entry[reductiontarget] void statsAssembled();

    // DiffusionNeighbors
    entry[reductiontarget] void findNBors(int do_again);

    entry[reductiontarget] void print_max_load(double max);
    entry[reductiontarget] void print_avg_load(double sum);
    entry[reductiontarget] void print_num_migrations(int sum);
    entry[reductiontarget] void print_external_comm(double sum);
    entry[reductiontarget] void print_internal_comm(double sum);
    
    entry void beginMST();
    entry void startFirstRound();
    entry[reductiontarget] void findNBorsRound();
    entry[expedited] void proposeNbor(int nborId);
    entry[expedited] void askNbor(int nborId, int rnd);
    entry void update_peload(int rank, double load);
    entry[expedited] void okayNbor(int agree, int nborId);
    entry void ackNbor(int nbor);
    // Confirms an ackNbor was processed, so the asker can prove its edge is
    // symmetric before it reports the round done; see hsMaybeAdvance.
    entry[expedited] void ackNborDone();
    entry void roundsDone();
    entry[expedited] void migMsgAck();
    entry void acrossDone();
    entry void withinDone();

    entry void ReceiveFinalStats(
        std::vector<bool> isMigratable, std::vector<int> from_proc,
        std::vector<int> to_proc, int n_migrateobjs,
        std::vector<std::vector<LBRealType>> positions, std::vector<double> load,
        std::vector<LDCommData> commData);

    entry void receiveCentroid(int node, std::vector<LBRealType> centroid, int count);
    entry void ReceiveLoadInfo(int itr, double load, int node);
    entry void ReceiveStats(CkMarshalledCLBStatsMessage data);
    // entry void LoadTransfer(double load, int initPE, int objId);
    entry void LoadReceived(int objId, int fromPE, int ackPE);
    entry void AcrossNodeLB();

    // (pseudolb_barrier removed -- global convergence check deleted)

    entry[reductiontarget] void startMSTBarrier();

    entry void startStrategy();
    entry void startStrategyBarrier();
    // entry [reductiontarget] void DoneNodeLB();
    // entry void MigratedHelper(LDObjHandle h, int waitBarrier);
    entry void ProcessMigrations();
    entry void ProcessFinalStats();
    entry void CollectStats();
    entry void next_phase(int val);
    entry void LoadMetaInfo(LDObjHandle h, int objId, double load, int senderPE, int only_mcount, int ackPE);
    entry void MigrationDoneWrapper();  // Call when migration is complete
    entry void WithinNodeLB();
  
    entry void buildMSTinRounds(double best_weight, int best_parent, int best_to);
    entry void next_MSTphase(double newcost, int newparent, int newto);

    // entry void MigrationInfo(int to, int from);
    // entry void ResumeClients(CkReductionMsg * msg);
    // entry void ResumeClients(int balancing);

    entry void PseudoLoad(int itr, double load, int node);
    // Fires on PE 0 once the neighbour handshake has drained (quiescence), which
    // is what guarantees the neighbour graph is symmetric before the rounds start.
    entry void beginPseudoRounds();
    // Seeds the section cookie on each member, then starts its round loop.
    entry void pseudoRoundStart(PseudoRoundMsg* m);
    // Reduction result lands here on PE 0, which multicasts the verdict to the
    // section; members wait for it inside the round loop.
    entry [reductiontarget] void pseudoVerdictRoot(double maxRatio);
    // Verdict multicast. This MUST take a CkMcastBaseMsg-derived message: a
    // CkMulticast-delegated section send stamps the section cookie over the head
    // of the outgoing message, which silently shreds a marshalled one.
    entry void pseudoConvergeResult(PseudoRoundMsg* m);
    // Local hand-off from pseudoConvergeResult into the SDAG round loop.
    entry void pseudoVerdict(double maxRatio);
    // pseudoDone / pseudolb_barrier removed with the global convergence check;
    // see the note in the pseudolb_rounds loop below.
    // entry void CallResumeClients();
    // entry void PrintDebugMessage(int len, double result[len]);
    entry void createCentroidList()
    {
      serial
      {
        initializeCentroid();
      }

      for (centReceiveNode = 0; centReceiveNode < numNodes; centReceiveNode++)
      {
        when receiveCentroid(int node, std::vector<LBRealType> centroid, int objCount)
            serial
        {
          processReceiveCentroid(node, centroid, objCount);
        }
      }

      serial "Sorting nbors"
      {
        finishCentroidList();
      }
    }

    entry void pseudolb_rounds()
    {
      serial
      {
        std::string neighborsStr;
        for (int i = 0; i < neighborCount; i++)
        {
          neighborsStr += std::to_string(sendToNeighbors[i]);
          if (i < neighborCount - 1)
          {
            neighborsStr += ", ";
          }
        }

        if (_lb_args.debug() > 1) CkPrintf("Node %d has neighbors: %s\n", myNodeId, neighborsStr.c_str());

        // The graph this member holds is final: keep it for later steps.
        hs_graphCached = true;

        // Size the per-neighbour vectors off the list the loops below actually
        // walk. findNBorsRound latches neighborCount before the last round's
        // handshake has landed, so the two can disagree by an entry or two.
        neighborCount = sendToNeighbors.size();

        loadNeighbors.clear();
        toSendLoad.clear();

        loadNeighbors.resize(neighborCount, 0);
        toSendLoad.resize(neighborCount, 0);
        toReceiveLoad.resize(neighborCount, 0);
        // Momentum starts at zero each LB step: the first round is pure first-order.
        prevRoundToSend.assign(neighborCount, 0.0);

        my_pseudo_load = my_load;
        pseudo_itr = 0;
        pseudo_converged = false;
        prev_pseudo_load = my_load;
        isPseudoRoot = (CkMyPe() == rank0PE);
      }

      // Rounds stop when diffusion has nothing left worth moving, rather than
      // always running the fixed bound. The check is a reduction over the
      // section of diffusing PEs -- one per node -- whose verdict is multicast
      // back, replacing the O(N) fan-in to PE 0 that the old check used. Only
      // section members reach this code, so no idle PE is dragged into the
      // round lockstep.
      while (pseudo_itr < ITERATIONS && !pseudo_converged)
      {
        if (isPseudoRoot)
        {
        // Send its load
        serial "Communicate load info"
        {
          for (int i = 0; i < neighborCount; i++)
          {
            thisProxy[sendToNeighbors[i] * nodeSize].ReceiveLoadInfo(
                pseudo_itr, my_pseudo_load, myNodeId);
          }
        }

        // Wait for all its neighbors load
        for (temp_itr = 0; temp_itr < sendToNeighbors.size(); temp_itr++)
        {
          when ReceiveLoadInfo[pseudo_itr](int itr, double load, int node) serial
          {
            int pos = findNborIdx(node);
            if (pos < 0)
              CkPrintf("[DiffusionLB] ERROR: node %d got round-%d load from non-neighbour "
                       "node %d -- neighbour graph is asymmetric\n", myNodeId, itr, node);
            else
              loadNeighbors[pos] = load;
          }
        }

        // Calculate average and do pseudo load balancing
        serial "Pseudo LB"
        {
          // avgLoadNeighbor = avgNborLoad();
          PseudoLoadBalancing();
        }

        for (temp_itr = 0; temp_itr < sendToNeighbors.size(); temp_itr++)
        {
          when PseudoLoad[pseudo_itr](int itr, double load, int node) serial
          {
            my_pseudo_load += load;
            int pos = findNborIdx(node);
            if (pos < 0)
              CkPrintf("[DiffusionLB] ERROR: node %d got round-%d transfer from non-neighbour "
                       "node %d -- neighbour graph is asymmetric\n", myNodeId, itr, node);
            else
              toSendLoad[pos] -= load;
          }
        }

        }  // end if (isPseudoRoot)

        // Global convergence check, restored as a reduction. Each node reports
        // the largest share of its own load it still wants to shift; the max
        // across the group decides, and the verdict is broadcast to everyone.
        // Nodes converge on the first round or two here -- diffusion typically
        // wants to move ~1% -- so this replaces most of the fixed round count
        // with two collectives.
        serial "Convergence contribute"
        {
          pseudo_metric = 0.0;
          if (isPseudoRoot)
          {
            // Converged means the diffused loads have stopped moving, not that
            // this round proposed no transfers: PseudoLoadBalancing recomputes
            // the transfers from the current load differences every round, so
            // the residual never decays to zero even at equilibrium. What does
            // settle is my_pseudo_load itself.
            const double denom = (my_load > 1e-12) ? my_load : 1e-12;
            pseudo_metric = fabs(my_pseudo_load - prev_pseudo_load) / denom;
            prev_pseudo_load = my_pseudo_load;
          }
          // Reduce across the section's members only. The result goes to PE 0,
          // which multicasts the verdict back so every member leaves the loop
          // on the same round.
          CkMulticastMgr* mg =
              CProxy_CkMulticastMgr(pseudoMcastGid).ckLocalBranch();
          mg->contribute(sizeof(double), &pseudo_metric, CkReduction::max_double,
                         pseudoCookie,
                         CkCallback(CkReductionTarget(DiffusionLB, pseudoVerdictRoot),
                                    thisProxy[0]));
        }

        when pseudoVerdict(double maxRatio) serial "Convergence verdict"
        {
          pseudo_converged = (maxRatio <= PSEUDO_CONVERGE_RATIO);
          pseudo_itr++;
          if (isPseudoRoot && myNodeId == 0 && (pseudo_converged || pseudo_itr == ITERATIONS)
              && _lb_args.debug() >= 1)
            CkPrintf("[DiffusionLB] pseudo rounds run: %d (converged=%d, max ratio %g)\n",
                     pseudo_itr, (int)pseudo_converged, maxRatio);
        }
      }

      // Calculate the aggregate load that has to be sent.
      serial "Aggregate load"
      {
        if (!isPseudoRoot) return;
        endPseudoLBTiming();
        startAcrossTiming();
        if (_lb_args.debug() > 1) CkPrintf("PSEUDO: Node %d (load %f) with pseudo_load after LB %f\n", myNodeId,
                 my_load, my_pseudo_load);
        loadReceivers = 0;
        // Every member leaving the loop is the whole condition AcrossNodeLB
        // needs: the convergence verdict cannot have been issued while any
        // round message was unprocessed, so nothing of the rounds is in
        // flight once the last member reports.
        thisProxy[0].roundsDone();
      }
    }
  };
};
