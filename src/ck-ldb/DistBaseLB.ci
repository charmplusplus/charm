module DistBaseLB {

extern module LBManager;
extern module BaseLB;


group [migratable] DistBaseLB: BaseLB {
  entry void DistBaseLB(const CkLBOptions &);  
  entry void LoadBalance();
  entry [reductiontarget] void barrierDone();
  // Sent to every PE of a process by the PE that built the round's GPU loads;
  // see the arrival gate in barrierDone.
  entry [expedited] void gpuLoadsReady();
  // Pre-move device loads of objects that left another process for this PE (hapi kCuptiDeferFlag), and how
  // many such messages every PE is owed, so the stats wait for all of them.
  entry [expedited] void receiveDepartedLoads(int n, int omIdx[n], CmiUInt8 objIds[n], double loads[n]);
  entry [reductiontarget] void departedCounts(int n, int counts[n]);
  entry [reductiontarget] void ResumeClients();
  entry void ResumeClients(int balancing);
#if CMK_GLOBAL_LOCATION_UPDATE
  // DistBaseLB has no global move list the way CentralLB does -- each PE
  // only knows the objects it is migrating away. This lets a migrating PE
  // broadcast those moves so every other PE's location cache stays current
  // for them too (see DistBaseLB::BroadcastLocationUpdate).
  entry void ReceiveLocationUpdate(LBMigrateMsg*);
#endif
};

};
