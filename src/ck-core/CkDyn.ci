// CkDyn: the message types and the per-PE manager group of the dynamic-chare
// layer (src/ck-core/ckdyn.h, ckdyn.C). The dynamic chare classes themselves
// are registered at run time by CkDynRegisterClass, not here.
module CkDyn {
  message CkDynMsg { char buf[]; };
  message CkDynMcastMsg { char buf[]; };

  readonly CkGroupID _ckdynMgrGID;
  readonly CkGroupID _ckdynMcastGID;   // the CkMulticastMgr behind CkDyn sections

  initnode void _ckdynInitNode(void);
  initproc void _ckdynInitProc(void);

  group [migratable] CkDynMgr {
    entry CkDynMgr();
    // a binding future's value; the future id is the envelope's reference number.
    // notrace: a binding coroutine resumed here traces its own event (CkDynCoroResume)
    entry [notrace] void deposit(CkDynMsg *m);
    // a section callback's result, forwarded to the section (any message type arrives here)
    entry void relay(CkDynMsg *m);
    // a CkDynHapiAddCallback completion: m carries the CkDynCallback to send to
    entry void hapiDone(CkDynMsg *m);
    // sections rooted on this PE (doc/internals/ckdyn.md, "Sections")
    entry void sectionSend(CkDynMcastMsg *m);
    entry void sectionQuery(int combIdx, int combGen, int partNo, int idx, int gen, int replyPe);
    entry void sectionParts(int combIdx, int combGen, int partNo, int kind, int ndims,
                            std::vector<int> aids, std::vector<int> counts, std::vector<int> flat);
    entry void sectionDelete(int idx, int gen);
  };
};
