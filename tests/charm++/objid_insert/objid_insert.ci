mainmodule objid_insert {
  readonly CProxy_Main mainProxy;
  readonly CProxy_Elem arrProxy;
  readonly CProxy_Inserter inserterProxy;
  readonly int K;
  readonly int bounded;

  mainchare Main {
    entry Main(CkArgMsg* m);
    entry [reductiontarget] void phase1Done();
    entry void registerElem(int x, int y, CmiUInt8 id, int pe, int demand);
    entry [reductiontarget] void pingDone(int nElems, int nPings);
    entry [reductiontarget] void reportDone(int nElems, int nRevives,
                                            int nDemand, int nMigrations);
    entry void quiescent();
    entry void checkProgress();
  };

  group Inserter {
    entry Inserter();
    entry void phase1();
    entry void sendPings(int round, std::vector<int> xs, std::vector<int> ys);
    entry void sendRevives();
    entry void dumpState();
  };

  array [2D] Elem {
    entry Elem(int origin);
    entry Elem();
    entry void ping(int round, int fromPe);
    entry [createhome] void revive(int round);
    entry void migrateNow(int seed);
    entry void maybeDie(int seed);
    entry void report();
    entry void dumpState();
  };
};
