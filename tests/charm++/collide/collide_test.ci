mainmodule collide_test {
  readonly CProxy_Main mainProxy;
  readonly int nChunks;

  mainchare Main {
    entry Main(CkArgMsg *m);
    entry void collisions(CkReductionMsg *m);
    entry [reductiontarget] void migrated();
  };

  array [1D] Chunk {
    entry Chunk(CollideHandle collide);
    entry void doStep(int step);
    entry void migrateAway(int step);
  };
};
