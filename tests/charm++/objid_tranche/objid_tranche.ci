mainmodule objid_tranche {
  readonly CProxy_Main mainProxy;
  readonly std::vector<CProxy_Elem> arrProxies;
  readonly CProxy_Checker checkerProxy;
  readonly int nMain;
  readonly int nPerPe;
  readonly int nArrays;
  readonly int nRevive;
  initnode void unbufferStdout(void);

  mainchare Main {
    entry Main(CkArgMsg* m);
    entry void registerElem(int a, int x, int y, CmiUInt8 id, int pe, bool atHome);
    entry void checkerDone(int pe, int nullLocal);
    entry void insertsQuiet();
    entry void pong(int a, int x, int y, CmiUInt8 id, int pe);
    entry void migratedQuiet();
    entry void revived(int a, int x, int y, int from, int pe);
    entry void revivesQuiet();
    entry void checkProgress();
  };

  group Checker {
    entry Checker();
    entry void insertMore();
    entry void reviveAll();
  };

  array [2D] Elem {
    entry Elem();
    entry void ping();
    entry void migrateOnce();
    entry [createhome] void revive(int from);
  };
};
