mainmodule ckcoro_tests {
  extern module basic;
  extern module refnum;
  extern module migration;
  extern module owners;

  readonly CProxy_Main mainProxy;
  readonly CProxy_MigrationTest migrationTestProxy;
  readonly CProxy_BasicTest basicTestProxy;
  readonly CProxy_RefnumTest refnumTestProxy;

  // Migratable: a checkpoint (-chkpt DIR) is taken during the owner tests
  // while runOwners, the own coroutine entry of Main, is suspended.
  mainchare [migratable] Main {
    entry Main(CkArgMsg* msg);
    entry void doBasicTest();
    entry void basicTestDone();
    entry void doRefnumTest();
    entry [reductiontarget] void refnumTestDone();
    entry void doMigrationTest();
    entry [reductiontarget] void migrationTestDone();
    entry void doMarshallTest();
    entry [reductiontarget] void marshallTestDone();
    entry void marshallLeakCheck();
    entry void doOverlapTest();
    entry [reductiontarget] void overlapTestDone();
    // The mainchare as a coroutine owner, driving the owners module.
    entry [coroutine] void runOwners(int rounds);
    entry [inbox, reductiontarget] void groupReady();
    entry [inbox, reductiontarget] void nodeGroupReady();
    entry [inbox] void chareReady();
    entry [inbox] void checkpointed();
    entry [inbox, reductiontarget] void groupDone(int sum);
    entry [inbox, reductiontarget] void nodeGroupDone(int sum);
    entry [inbox] void chareDone(int sum);
  }

  // Overlap and forall as child coroutines, and a coroutine entry with
  // marshalled parameters (re-supplied by the restart).
  array [1D] OverlapTest {
    entry OverlapTest();
    entry [coroutine] void run(int rounds, std::vector<int> seeds, int nitems, double weights[nitems]);
    entry [inbox] void a(int r, int v);
    entry [inbox] void b(int r, int v);
    entry [inbox] void item(int tag, int v);   // tag = round * items + i
  }

  // A custom pack and unpack (the unpacked message holds a heap array).
  message PackMsg;

  // Marshalled inbox entries: the parameters stay in the message being
  // delivered, which the inbox keeps (and pups under +ck_fakemigrate).
  array [1D] MarshallTest {
    entry MarshallTest();
    entry [coroutine] void run();
    // Matched by the first argument (SDAG: when recv[iter](...)).
    entry [inbox] void recv(int iter, std::vector<int> values);
    // A broadcast: every element keeps a reference to one message.
    entry [inbox] void tag(int t, double x);
    // Reached through the reduction wrapper: the arguments are packed.
    entry [inbox, reductiontarget] void total(int sum);
    entry [inbox] void arr(int iter, int n, double data[n], std::vector<int> tail);
    entry [inbox, reductiontarget] void arrTotal(int n, double sums[n]);
    // Called directly from the coroutine, inside the delivery of a reduction.
    entry [inbox] void tick(int it, double v);
    // A coroutine entry taking a message with a custom pack: the state owns
    // the message, which stays valid across waits and restarts.
    entry [inbox, reductiontarget] void runsDone();
    entry [coroutine] void packRun(PackMsg* m);
    entry [inbox] void step(int it);
  }
}
