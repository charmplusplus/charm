mainmodule memckpt_rollback {
  readonly CProxy_Main mainProxy;
  readonly CProxy_Tally tallyProxy;
  readonly CProxy_Worker workerProxy;
  readonly int numElements;
  readonly int lbMode;
  readonly int changeMode;
  readonly int numRollbacks;

  mainchare Main {
    entry Main(CkArgMsg *m);
    entry [reductiontarget] void stepDone(int n, long data[n]);
    entry void afterCheckpoint();
    entry [reductiontarget] void tallyDone(int good, int bad);
    entry void checkHomes();
    entry [reductiontarget] void homesDone(int stale);
  };

  array [1D] Worker {
    entry Worker();
    entry void doStep(int s);
    entry void token(int s);
    entry void reportPe();
  };

  group Tally {
    entry Tally();
    entry void check();
    entry void startHomes();
    entry void notePe(int idx, int pe);
  };
};
