mainmodule lbsweep {
  readonly CProxy_Main mainProxy;
  readonly int numElems;
  readonly int numSteps;
  readonly int numIters;
  readonly int profile;
  readonly int nonmigEvery;
  readonly int manualLB;

  initproc void lbsweepInitProc(void);

  mainchare Main {
    entry Main(CkArgMsg *m);
    entry [reductiontarget] void stepDone(int n, double v[n]);
    entry [reductiontarget] void readyForLB();
  };

  group PackedMap : CkArrayMap {
    entry PackedMap();
  };

  array [1D] Elem {
    entry Elem();
    entry void recvGhost(int ref, int from, double v);
    entry void ResumeFromSync();
    entry void run() {
      for (step = 0; step < numSteps; step++) {
        for (iter = 0; iter < numIters; iter++) {
          serial { sendGhosts(); }
          for (got = 0; got < 2; got++) {
            when recvGhost[step * numIters + iter](int ref, int from, double v)
              serial { checkGhost(ref, from, v); }
          }
        }
        serial {
          prevPE = CkMyPe();
          AtSync();
          if (manualLB) contribute(CkCallback(CkReductionTarget(Main, readyForLB), mainProxy));
        }
        when ResumeFromSync() serial { report(); }
      }
    };
  };
};
