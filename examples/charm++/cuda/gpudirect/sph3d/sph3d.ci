mainmodule sph3d {
  include "sph3d.h";

  readonly CProxy_Main main_proxy;
  readonly CProxy_Patch patch_proxy;

  readonly RealType dom_lx;        // tank extent (incl. walls): length, depth, height
  readonly RealType dom_ly;
  readonly RealType dom_lz;
  readonly int n_chares_x;
  readonly int n_chares_y;
  readonly int n_chares_z;

  readonly RealType spacing;       // initial particle spacing
  readonly RealType smooth_h;      // smoothing length
  readonly RealType support;       // kernel support radius, KERNEL_SUPPORT*h
  readonly RealType pmass;         // per-particle mass (uniform lattice)
  readonly RealType rho0;
  readonly RealType sound_c0;
  readonly RealType gravity;
  readonly RealType sim_dt;
  readonly RealType wall_t;        // wall thickness
  readonly RealType col_w;         // initial water column: width along x,
  readonly RealType col_h;         // height along z; it spans the full depth
  readonly RealType init_vx;       // initial fluid velocity, +x

  readonly int n_iters;
  readonly int warmup_iters;
  readonly int first_lb;
  readonly int lb_freq;
  readonly int async_lb;
  readonly int lb_wait_lag;
  readonly int lattice_nx;      // lattice extents, for the global particle id
  readonly int lattice_ny;
  readonly int part_capacity;
  readonly int exch_capacity;   // face slot; edges and corners are smaller
  readonly int concurrent_x;    // -c: halo and migration of a step sent together (one wait per step)
  readonly int stats_freq;

  readonly int nl_freq;            // neighbour-list window (-k): cell list, halo
                                   // membership and migration every nl_freq steps
  readonly int integrator;         // 0 Euler-Cromer, 1 predictor-corrector (-p)
  readonly RealType verlet_margin; // -m, in units of h: widens the cells and the halo
  readonly RealType cell_size;     // support + verlet_margin * h

  readonly CProxy_HostProfGroup prof_proxy;

  group HostProfGroup {
    entry HostProfGroup();
    entry void report(CkCallback cb);
  };

  mainchare Main {
    entry Main(CkArgMsg* m);
    entry void initDone(CkReductionMsg* msg);
    entry void stepStats(CkReductionMsg* msg);
    entry [reductiontarget] void allDone();
    entry [reductiontarget] void profDone();
    entry void latDone(CkReductionMsg* msg);
    entry void watchdog();
    entry void idAudit(CkReductionMsg* msg);
  };

  array [3D] Patch {
    entry Patch(void);
    entry void init();
    entry void iterate();

    entry void haloPacked();
    entry void haloPacked2();
    entry void leaversPacked();
    entry void sendDone();
    entry void sendsDrained();

    // ts: the sender's hapiTraceTimestamp() at the send, for the message
    // latency (envelope and payload) that the receiver records; src: the sender's PE, so the
    // receiver tiers the message exactly (the location cache misses the in-process
    // partners of a multi-device process).
    entry void receiveHalo(int ref, int dir, int n, long long ts, int src, int m,
                           nocopydevice Particle parts[m]);
    entry void receiveHalo2(int ref, int dir, int n, long long ts, int src, int m,
                            nocopydevice Particle parts[m]);
    entry void receiveParticles(int ref, int dir, int adv, int n, long long ts, int src, int m,
                                nocopydevice Particle parts[m]);
    entry void exchangePacked();
    // The concurrent exchange's receives are plain entries: the payload is in
    // this patch's slot or ghost region when the body runs, the body only
    // records the arrival, and the step waits on migrantsDone / halosDone,
    // which the last arrival (or the opening of the step) sends. No device
    // message is ever buffered in the SDAG, which the runtime's migration
    // path does not support (ckrdmadevice.C: "no device-zerocopy message is
    // buffered at migration time").
    entry void receiveHaloC(int ref, int dir, int n, long long ts, int src, int m,
                            nocopydevice Particle parts[m]);
    entry void receiveParticlesC(int ref, int dir, int adv, int n, long long ts, int src, int m,
                                 nocopydevice Particle parts[m]);
    entry void migrantsDone(int ref);
    entry void halosDone(int ref);
    entry void dumpState();      // SPH_STUCK_SECONDS: every patch prints what it waits for
    entry void dumpId(int id);   // SPH_ID_AUDIT: every holder of this id prints itself

    // Same phase order as sph2d.ci (the halo is consumed before the migration
    // send, which is what lets d_recv_halo have one slot per direction while
    // d_recv_mig needs two). The predictor-corrector adds a second halo
    // exchange of the predicted state between the two force evaluations; it
    // has its own entry methods and staging buffer because a partner can post
    // its second exchange before this patch has consumed its first.
    entry void runStep() {
      serial { my_iter++; startHalo(); }
      when haloPacked() serial { sendHalo(); }
      for (recv_count = 0; recv_count < n_expect; recv_count++) {
        when receiveHalo[my_iter](int ref, int dir, int n, long long ts, int src, int m,
                                  nocopydevice Particle parts[m])
          serial { noteLanded(0, ref, dir, ts, src); appendGhosts(dir, n); }
      }
      serial { computeForces(); }
      if (pc_step) {
        when haloPacked2() serial { sendHalo2(); }
        for (recv_count = 0; recv_count < n_expect; recv_count++) {
          when receiveHalo2[my_iter](int ref, int dir, int n, long long ts, int src, int m,
                                     nocopydevice Particle parts[m])
            serial { noteLanded(2, ref, dir, ts, src); appendGhosts2(dir, n); }
        }
        serial { correct(); }
      }
      when leaversPacked() serial { sendLeavers(); }
      for (recv_count = 0; recv_count < n_expect_mig; recv_count++) {
        when receiveParticles[my_iter](int ref, int dir, int adv, int n, long long ts, int src, int m,
                                       nocopydevice Particle parts[m])
          serial { noteLanded(1, ref, dir, ts, src); appendParticles(ref, dir, n); }
      }
      serial { gateStepDrain(); }
      when sendsDrained() serial { endOfStep(); }
    };

    // The concurrent exchange (-c): the halo and the migration of a step are
    // sent together at the end of the previous step, so a step is one wait
    // for both instead of two in sequence (see sph3d.C "CONCURRENT EXCHANGE").
    // The migrants are consumed first: their advertisements say which halos
    // to expect. Step 1's exchange comes from a prologue pack of the initial
    // state.
    entry void runStepC() {
      serial { my_iter++; beginStepC(); }
      if (my_iter == 1) {
        when exchangePacked() serial { sendExchange(); }
      }
      when migrantsDone[my_iter](int ref) serial { mergeMigrantsC(); }
      when halosDone[my_iter](int ref) serial { mergeHalosC(); parkOrComputeC(); }
      when exchangePacked() serial { sendExchange(); }
      serial { gateStepDrain(); }
      when sendsDrained() serial { endOfStep(); }
    };
  };
};
