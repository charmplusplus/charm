mainmodule barnes {
  
  readonly CProxy_TreePiece treePieceProxy;
  readonly CProxy_DataManager dataManagerProxy;
  readonly CProxy_Main mainProxy;
  readonly Parameters globalParams;
#ifdef GPU_GRAVITY
  readonly CProxy_StreamPool streamPool;
#endif

  initnode void registerReducers();

  class Parameters;
  class MultipoleMoments;

  message SplitterMsg {
    int splitBins[];
  };

  message ParticleMsg {
    Particle part[];
  };

  message RangeMsg {
    Key keys[];
  };

  message ParticleBlockMsg {
    int tpIndex[];
    int tpCount[];
    Key tpKeys[];
    Particle parts[];
  };

  message RequestMsg;
  message ParticleReplyMsg {
    ExternalParticle data[];
  };

  message NodeReplyMsg {
    Node<ForceData> data[];
  };

  message MomentsMsg;
  message RescheduleMsg;

  include "Descriptor.h";

  group BlockCyclicMap : CkArrayMap {
    entry BlockCyclicMap(int chunk);
  };

  mainchare Main {
    entry Main(CkArgMsg *m);
    entry [threaded] void commence();
    entry void niceExit();
    entry void quiescence();
    entry void quiescenceExit();
  };

#ifdef GPU_GRAVITY
  group StreamPool {
    entry StreamPool();
  };
#endif

  array[1D] TreePiece {
    entry TreePiece();
    entry void requestMoments(Key k, int replyTo);

    entry void startTraversal();
    entry void doLocalGravity(RescheduleMsg *);
    entry void doRemoteGravity(RescheduleMsg *);

    entry void requestParticles(RequestMsg *msg);
    entry void requestNode(RequestMsg *msg);
    entry void quiescence();

#ifdef GPU_GRAVITY
    // Both exist so every launch happens under this chare's CUPTI
    // correlation; see TreePiece::traversalDone.
    entry void finishGpuWork();
    entry void gpuWorkDone();
#endif
  };

  group DataManager {
    entry DataManager();
    entry void loadParticles(CkCallback &cb);
    entry void decompose(BoundingBox &universe);
    entry void receiveHistogram(CkReductionMsg *msg);
    entry void receiveSplitters(SplitterMsg *msg);
    entry void sendParticles(RangeMsg *msg);
    // The decomposition exchange. Both are DataManager-to-DataManager: the
    // tree pieces are no longer in this path at all, because the receiving
    // DataManager can attribute incoming particles to its own local elements.
    entry void beginDistribute();
    entry void recvTreePieceMap(CkReductionMsg *msg);
    entry void recvSenderCounts(CkReductionMsg *msg);
    entry void recvFrontierMoments(CkReductionMsg *msg);
    entry void receiveParticleBlock(ParticleBlockMsg *msg);
    entry void receiveMoments(MomentsMsg *msg);

    entry void recvParticles(ParticleReplyMsg *msg);
    entry void recvNode(NodeReplyMsg *msg);
    entry void advance(CkReductionMsg *msg);
#ifdef STATISTICS
    entry void traversalsDone(CmiUInt8 pnInter, CmiUInt8 ppInter, CmiUInt8 openCrit);
#else
    entry void traversalsDone();
#endif

    entry void recvUnivBoundingBox(CkReductionMsg *msg);
    entry void treePiecesReady(CkReductionMsg *msg);
    entry void treePiecesMigrated(CkReductionMsg *msg);
#ifdef GPU_GRAVITY
    entry void forcesReady();
    // Stage 2 split the two host passes that used to run inline. The
    // integrator and the key generation are device work now, so the entry
    // method that needed their result has to be reached from a HAPI callback
    // rather than falling through.
    entry void advanceTail();
    entry void decomposeTail();
#endif

    entry void quiescence();
  };
};
