CHARM_PATH = ../charm
CHARM_LDB_PATH = $(CHARM_PATH)/src/ck-ldb
CHARM_UTIL_PATH = $(CHARM_PATH)/src/util
CHARM_LIB_PATH = $(CHARM_PATH)/lib
INCPATH = $(CHARM_PATH)/include
STRUCTURES_PATH = ../utility/structures

VPATH = $(STRUCTURES_PATH)

# GPU=1 evaluates the forces on the device: the traversal builds interaction
# lists instead of calling grav(), and one kernel per tree piece consumes them.
# GPU=0 keeps the original CPU force loop, so the example still builds against
# a Charm++ without CUDA.
GPU ?= 1

NVCC = nvcc
# sm_70 covers V100 onward; add to this for older or newer devices.
NVCC_ARCH ?= -gencode arch=compute_70,code=sm_70 \
             -gencode arch=compute_80,code=sm_80 \
             -gencode arch=compute_86,code=sm_86
CUDA_PATH ?= $(dir $(shell which nvcc))..

APP_FLAGS = -DSTATISTICS #-DVERBOSE_TRAVERSAL -DCHECK_NUM_INTERACTIONS -DPRINT_TREE -DDEBUG_TRAVERSALS #-DVERBOSE_NODE_REFINE
OPTS = -O3 -g $(APP_FLAGS)

OBJECTS = Main.o DataManager.o TreePiece.o util.o Reduction.o Worker.o Request.o State.o
# EveryLB pulls in GreedyRefineCentralGPULB; DiffusionLB is its own module.
LB_MODULES = -module EveryLB -module DiffusionLB

ifeq ($(GPU),1)
  # Nothing here selects hapiAddCallback's stream-callback path over its
  # event-polling one: HAPI_CUDA_CALLBACK is read when the hybridAPI library is
  # compiled, not when this application is. Either path delivers the callback,
  # and nothing in this port depends on which.
  APP_FLAGS += -DGPU_GRAVITY
  OBJECTS += GpuBatch.o barnesCUDA.o
  GPU_LDFLAGS = -L$(CUDA_PATH)/lib64 -lcudart
endif

CXXFLAGS += $(OPTS) -I$(INCPATH) -I$(STRUCTURES_PATH)
LDFLAGS += $(OPTS) -L. -language charm++ $(LB_MODULES) $(GPU_LDFLAGS) -memory os #-tracemode projections

CHARMC = $(CHARM_PATH)/bin/charmc

CXX = $(CHARMC)
CC = $(CXX)
AR = ar q
CXX_DEPEND = $(CXX) -M -MM -MG -Wall $(APP_FLAGS)
CFLAGS = $(OPTS) $(DEFINE_FLAGS) -g

SRC = Main.cpp DataManager.cpp TreePiece.cpp \
      util.cpp Reduction.cpp Worker.cpp Request.cpp \
      State.cpp GpuBatch.cpp particleGenerator.cpp gen_util.cpp plummer.cpp

TARGET = barnes
all: $(TARGET) gen plummer

$(TARGET): $(OBJECTS) Makefile.dep
	$(CHARMC) -o $(TARGET) $(LDFLAGS) $(OBJECTS)

# The kernel needs barnes.decl.h only indirectly, through nothing at all: it
# includes barnes_cuda.h and no Charm++ header, so nvcc never sees a generated
# file or a Charm++ template.
barnesCUDA.o: barnes.cu barnes_cuda.h
	$(NVCC) -O3 -std=c++14 $(NVCC_ARCH) -c -o $@ $<

# Makefile.dep is generated by `make depends`, which needs a working charmc, and
# it predates the GPU headers. Until it is regenerated, name them here so an
# edit to one actually rebuilds what includes it.
$(OBJECTS): GpuBatch.h StreamPool.h barnes_cuda.h

gen: particleGenerator.cpp
	g++ -o gen particleGenerator.cpp

plummer.o: plummer.cpp
	g++ -I$(STRUCTURES_PATH) -I$(INCPATH) -c plummer.cpp

gen_util.o: gen_util.cpp
	g++ -I$(STRUCTURES_PATH) -c gen_util.cpp

plummer: plummer.o gen_util.o
	g++ -I$(STRUCTURES_PATH) -o plummer plummer.o gen_util.o

%.decl.h %.def.h : %.ci
	$(CHARMC) $(APP_FLAGS) -E $<

%.o: Makefile

clean:
	rm -f core* $(OBJECTS) *~ $(TARGET) *.decl.h *.def.h charmrun conv-host

depends:
	$(CXX_DEPEND) $(SRC) | while read i;do echo $$i| awk -F' ' '{for (i=1;i<NF;++i) print $$i" \\"}';echo;done|grep -v "$(CHARM_PATH)/bin" > Makefile.dep

.PHONY: all docs depends

include Makefile.dep
