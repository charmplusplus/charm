// The coroutine version of examples/charm++/fib: the SDAG entry calc()
// becomes a [coroutine] entry and the entry it waits for an [inbox] entry.
mainmodule fib {
  mainchare Main {
    entry Main(CkArgMsg* m);
  };

  chare Fib {
    entry Fib(int n, bool isRoot, CProxy_Fib parent);
    entry [coroutine] void calc(int n);
    entry [inbox] void response(int val);
  };
};
